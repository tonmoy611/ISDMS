# ISDMS environment. Copy to .env and fill in. Never commit .env.
NODE_ENV=development
APP_NAME=ISDMS
APP_VERSION=0.1.0
PORT=5000
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=isdms_user
DB_PASSWORD=
DB_NAME=isdms
DB_POOL_LIMIT=10

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info

# --- Authentication (Phase 02) ---
# Required. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
BCRYPT_COST=12
# Defaults to true in production. Set false only for plain-HTTP local testing.
COOKIE_SECURE=
# One-time values for: npm run create-admin  (remove from .env afterwards)
SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email and SMS (Phase 06) ---
# Public address of the site, used in links inside emails. Required in production.
APP_URL=http://localhost:5173
# smtp or log. "log" only prints messages to the server console (development); it never delivers anything.
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ISDMS <no-reply@example.edu>"
# none, log (development only) or bulksmsbd
SMS_PROVIDER=log
SMS_API_URL=https://bulksmsbd.net/api/smsapi
SMS_API_KEY=
SMS_SENDER_ID=
VERIFICATION_CODE_TTL_MIN=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_MAX_SENDS_PER_15MIN=3

# --- Enrollment (Phase 09) ---
# Time zone used to decide what today's date is for registration deadlines.
APP_TIMEZONE=Asia/Dhaka

# --- Attendance (Phase 10) ---
# Days after a class that a teacher may still create or correct its attendance. Managers are not limited.
ATTENDANCE_EDIT_DAYS=7
